# ==== 比赛数据：官方卡牌数据库 + C++ 引擎，不公开分发 ====
data/

# ==== 官方 starter kit：cg/ 为比赛方提供的引擎与 API，不公开分发 ====
cg/
deck.csv

# ==== 运行产物 / 缓存 ====
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# ==== 提交包产物 ====
dist/

# ==== 对局回放 / 日志 ====
replays/
logs/
*.log
*.log.bak
*.tmp

# ==== 排行榜导出 / 临时下载（别再被 `git add -A` 卷进来）====
*.zip
backup.ipync

# ==== 模型权重（训练产物，可用 train_value.py 重建）====
# ⚠️ 必须锚定根目录：写 `models/` 会匹配任意层级，
#    把 framework/models/ 这个代码目录也一起忽略掉。
/models/
*.pt
*.pth
*.onnx
*.json
*.bin
*.txt

# ==== 凭据：永远不要提交 ====
kaggle.json
access_token
.credentials*
*.pem
.env
epsoide/
episode/

# 大批量回放（13 GB，2026-10-23 抓的前两名队伍 1364 局）
epsoide_teams2/
epsoide_field2/
port_repo/

# ==== 二进制 agent 泳池（每份 20 MB，本地重建即可，不进 git）====
bc_pool/
build/agents/
ptcg_league/pools/

# ==== 已用 `git add -f` 显式跟踪的例外（改这里不会生效，需 -f）====
#   data/*.tsv *.csv（测量结果：our_games / ladder_games / arena_matches /
#                    bc_frame_labels / league_agents / matchup_matrix / seat_sidecar）
#   models/ppo/*.json *.log（每次训练的元数据与日志）
#   decks/pool_field/_manifest.json、bc_pool/registry.tsv
#   ptcg_league/{gen,state,reports}（联赛状态与开环计划）
