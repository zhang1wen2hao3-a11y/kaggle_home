diff --git a/native/ptcg/binding.c b/native/ptcg/binding.c
index 5f5ae62..e6b8892 100644
--- a/native/ptcg/binding.c
+++ b/native/ptcg/binding.c
@@ -42,6 +42,29 @@ void my_init(Env* env, Dict* kwargs) {
         snprintf(key, sizeof(key), "anchor_%d", i);
         env->anchor_idx[i] = (it = dict_get_unsafe(kwargs, key)) ? (int)it->value : 0;
     }
+    // TRACK_PARSE: observation-only deck list. 0 => fall back to the anchor
+    // list (keeps old runs numerically identical). Without this parse the
+    // counter loop would ALWAYS fall back -- which is exactly what the first
+    // v2 verification run showed (tl0=1.00 for the anchor slot, all to*=0).
+    env->n_track = (it = dict_get_unsafe(kwargs, "n_track")) ? (int)it->value : 0;
+    if (env->n_track > PT_MAX_ANCHORS) env->n_track = PT_MAX_ANCHORS;
+    if (env->n_track < 0) env->n_track = 0;
+    for (int i = 0; i < env->n_track; i++) {
+        char tkey[24];
+        snprintf(tkey, sizeof(tkey), "track_%d", i);
+        env->track_idx[i] = (it = dict_get_unsafe(kwargs, tkey)) ? (int)it->value : 0;
+    }
+    // BANK_DECKS_PARSE: per-bank deck binding (see tools/patch_bank_decks.py).
+    // Absent => 0 => the old global-weight draw, numerically identical.
+    env->n_bank_decks = (it = dict_get_unsafe(kwargs, "n_bank_decks")) ? (int)it->value : 0;
+    if (env->n_bank_decks > PT_MAX_BANKS) env->n_bank_decks = PT_MAX_BANKS;
+    if (env->n_bank_decks < 0) env->n_bank_decks = 0;
+    for (int i = 0; i <= PT_MAX_BANKS; i++) env->bank_deck[i] = -1;
+    for (int i = 0; i < env->n_bank_decks; i++) {
+        char bkey[28];
+        snprintf(bkey, sizeof(bkey), "bank_deck_%d", i);
+        env->bank_deck[i] = (it = dict_get_unsafe(kwargs, bkey)) ? (int)it->value : -1;
+    }
     env->p_anchor_learner =
