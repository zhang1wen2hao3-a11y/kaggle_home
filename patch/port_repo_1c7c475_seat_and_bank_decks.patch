@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""从 checkpoint 自带缓冲区导出 `data/embed_pca.npz`（冻结的文本嵌入表）。
+
+为什么这样做而不是重新算：文本嵌入原本由 `tools/embed_card_texts.py` 用
+OPENAI_API_KEY 生成，那个 key 已经不可得，而**线上 checkpoint 里已经把结果存成
+缓冲区**（`card_text (1448,128)` / `att_text (1772,64)` / `skill_text (497,64)`，
+新卡行真实非零）。所以直接从 checkpoint 取，比零填充或换一个本地模型更保真：
+换编码器会改变整个文本通道的分布，热启动的权重就白热了。
+
+用法：
+    python3 tools/export_embed_from_ckpt.py CKPT.pt [--out data/embed_pca.npz]
+"""
+import argparse
+import os
+import shutil
+import sys
+
+import numpy as np
+import torch
+
+ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
+sys.path.insert(0, ROOT)
+
+from ptcg.rl.buffers import N_CARDS, N_ATTACKS  # noqa: E402
+from ptcg.rl.cards import N_SKILLS               # noqa: E402
+
+WANT = {"cards": ("card_text", N_CARDS), "attacks": ("att_text", N_ATTACKS),
+        "skills": ("skill_text", N_SKILLS)}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("ckpt")
+    ap.add_argument("--out", default=os.path.join(ROOT, "data", "embed_pca.npz"))
+    a = ap.parse_args()
+    sd = torch.load(a.ckpt, map_location="cpu", weights_only=False)
+    sd = sd.get("model", sd.get("state_dict", sd))
+    out = {}
+    for key, (src, n) in WANT.items():
+        if src not in sd:
+            raise SystemExit(f"checkpoint 里没有 {src}")
+        t = sd[src].detach().cpu().numpy().astype(np.float32)
+        if t.shape[0] != n:
+            raise SystemExit(f"{src} 行数 {t.shape[0]} != N_* {n}（常量与 checkpoint 不一致）")
+        out[key] = t
+        nz = int((np.abs(t).sum(1) > 1e-6).sum())
+        print(f"  {key:8s} {t.shape}  非零行 {nz}/{n}")
+    if os.path.exists(a.out):
+        shutil.copyfile(a.out, a.out + ".bak")
+    np.savez_compressed(a.out, **out)
+    print(f"已写出 {a.out}")
+
+
+if __name__ == "__main__":
+    main()
