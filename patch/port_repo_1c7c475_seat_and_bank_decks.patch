     env->p_anchor_self_opp =
@@ -183,4 +206,22 @@ void my_log(Log* log, Dict* out) {
             dict_set(out, DECK_N_KEYS[i], log->deck_games[i]);
         }
     }
+    // Per-seat counts over --track-decks (G4 hard gate).
