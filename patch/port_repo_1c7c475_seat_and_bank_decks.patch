+#!/usr/bin/env python3
+"""把 `data/embed_pca.npz` 扩到当前表尺寸（新增行先按约定填 0）。
+
+为什么需要：`data/embed_pca.npz` 是按旧表预算的（cards 1284 / attacks 1573 /
+skills 448）。引擎现在的卡表是 1431 张卡 / 1755 个招式 / 470 个技能文本，所以
+`cards.py:load_text_tables()` 的 shape assert 必然失败。
+
+本脚本**不是**替代 `tools/embed_card_texts.py`（那个要 OPENAI_API_KEY）；它只保证
+管道能跑通：旧行原样保留，新行填 0（与 `build_embed_pca.py` 里"row 0 与 slack
+行都是 0"的既有约定一致）。新卡此时仍能通过 `card_static`（58 维真实属性：HP、
+属性、撤退、弱点…）和**各自独立的 id embedding** 被区分开 —— 这已经比现状
+（148 张新卡全部坍缩成 Fennekin 一行）好得多。
+
+真要用文本语义，需要按 docs/model.md:229-238 的三步重新生成。
+"""
+import os
+import shutil
+import sys
+
+import numpy as np
+
+ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
+sys.path.insert(0, ROOT)
+
+from ptcg.rl.buffers import N_CARDS, N_ATTACKS  # noqa: E402
+from ptcg.rl.cards import N_SKILLS               # noqa: E402
+
+SIZES = {"cards": N_CARDS, "attacks": N_ATTACKS, "skills": N_SKILLS}
+DIMS = {"cards": 128, "attacks": 64, "skills": 64}
+
+
+def main():
+    path = os.path.join(ROOT, "data", "embed_pca.npz")
+    z = np.load(path)
+    out = {}
+    for k, n in SIZES.items():
+        a = z[k]
+        assert a.shape[1] == DIMS[k], (k, a.shape)
+        if a.shape[0] >= n:
+            out[k] = a[:n]
+            print(f"  {k}: {a.shape[0]} → {n}（截断）")
+        else:
+            pad = np.zeros((n - a.shape[0], DIMS[k]), dtype=a.dtype)
+            out[k] = np.vstack([a, pad])
+            print(f"  {k}: {a.shape[0]} → {n}（新增 {n - a.shape[0]} 行填 0）")
+    if "--dry-run" not in sys.argv:
+        shutil.copyfile(path, path + ".bak")
+        np.savez_compressed(path, **out)
+        print(f"已写回 {path}（备份 {os.path.basename(path)}.bak）")
+
+
+if __name__ == "__main__":
+    main()
